
/ {
	hbridge {
		compatible = "pwm-leds";
		status = "okay";

		in1: in1 {
			pwms = < &sw_pwm 0 PWM_USEC(100) PWM_POLARITY_NORMAL >;
		};

		in2: in2 {
			pwms = < &sw_pwm 1 PWM_USEC(100) PWM_POLARITY_NORMAL >;
		};
	};
};

&sw_pwm {
	status = "okay";
	channel-gpios = < &gpio0 12 GPIO_ACTIVE_HIGH >,
	                < &gpio0 14 GPIO_ACTIVE_HIGH >;
	clock-prescaler = <4>;
};

&timer1 {
	status = "okay";
};

/* Low-frequency clock: run from the internal RC oscillator. This used to be
 * CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC; the accuracy has to be stated explicitly
 * because the binding defaults to 50 ppm, while RC on the nRF52 is 500 ppm and
 * the BLE controller reports this value as its sleep clock accuracy. */
&lfclk {
	k32src = "rc";
	k32src-accuracy-ppm = <500>;
};
